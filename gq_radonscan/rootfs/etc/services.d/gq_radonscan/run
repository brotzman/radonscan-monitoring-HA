#!/usr/bin/with-contenv bashio
set -euo pipefail
umask 077

export PYTHONPATH="/usr/local/lib${PYTHONPATH:+:$PYTHONPATH}"
export CONFIG_PATH=/data/options.json
export DATA_DIR=/data
export MQTT_HOST="$(bashio::services mqtt 'host')"
export MQTT_PORT="$(bashio::services mqtt 'port')"
export MQTT_USERNAME="$(bashio::services mqtt 'username')"
export MQTT_PASSWORD="$(bashio::services mqtt 'password')"

APP_VERSION="$(python3 -c 'from radonscan3 import __version__; print(__version__)')"
bashio::log.info "Starting Radon Monitoring ${APP_VERSION} read-only hourly SPIR service"
exec python3 /usr/local/bin/gq_radonscan_service.py
